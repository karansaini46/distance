<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Background image for transparency control -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_wide"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Left: Initials and Emoji -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_my_initial"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/circle_bg"/>

            <!-- Static Emoji (when animation is OFF) -->
            <TextView
                android:id="@+id/tv_emoji_static"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="❤️"
                android:textSize="16sp"
                android:visibility="gone"/>

            <!-- Cute animation ViewFlipper (when animation is ON) -->
            <ViewFlipper
                android:id="@+id/view_flipper_emoji"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:autoStart="true"
                android:flipInterval="1000">
                
                <TextView
                    android:id="@+id/tv_emoji_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="❤️"
                    android:textSize="16sp"/>
                    
                <TextView
                    android:id="@+id/tv_emoji_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="❤️"
                    android:textSize="12sp"/>
            </ViewFlipper>

            <TextView
                android:id="@+id/tv_partner_initial"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/circle_bg"/>
        </LinearLayout>

        <!-- Spacer -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Right: Distance Data -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--- km"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"/>

            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="syncing…"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
